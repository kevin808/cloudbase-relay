# ---- 必填 ----
# 上游网关主机名：只填域名，不要带 https:// 和 /v1
UPSTREAM_HOST=your-gateway-host.example.com

# 客户端访问密钥，逗号分隔；服务端用它校验 Authorization: Bearer
RELAY_KEYS=sk-please-change-me

# ---- 鉴权（二选一，密钥对优先）----
SECRET_ID=
SECRET_KEY=

# 备选：单一 API Key
# API_KEY=

# ---- 可选 ----
# REGION=ap-shanghai
# ALLOWED_MODELS=hy4,deepseek-v4.1-flash
# PORT=8080
# RELAY_LOG=1
