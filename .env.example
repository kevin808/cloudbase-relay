# ---- 必填 ----
# 上游地址：完整 URL 或只填主机名都可以
# 例：https://your-gateway-host.example.com/v1/ai/<provider>
UPSTREAM_URL=https://your-gateway-host.example.com/v1/ai/<provider>

# 客户端访问密钥，逗号分隔；服务端用它校验 Authorization: Bearer
RELAY_KEYS=sk-please-change-me

# ---- 鉴权（二选一，密钥对优先）----
SECRET_ID=
SECRET_KEY=

# 备选：单一 API Key
# API_KEY=

# ---- 可选 ----
# REGION=ap-shanghai
# ALLOWED_MODELS=hy4,deepseek-v4.1-flash
# PORT=8080
# RELAY_LOG=1
# RELAY_HEALTH_DETAIL=1   # 让 /healthz 返回上游地址等细节（默认隐藏）
