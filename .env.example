# ---- 必填 ----
# 云开发环境 ID（控制台 -> 环境概览）
TCB_ENV=your-env-id

# 客户端访问密钥，逗号分隔；服务端用它校验 Authorization: Bearer
RELAY_KEYS=sk-please-change-me

# ---- 鉴权（二选一，AK/SK 优先）----
# 腾讯云子账号密钥（推荐）
CLOUDBASE_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
CLOUDBASE_SECRET_KEY=xxxxxxxxxxxxxxxx

# 或者用云开发控制台 API Key
# CLOUDBASE_APIKEY=

# ---- 可选 ----
# 自定义网关主机名，只填主机名，不要带 https:// 和 /v1
# CLOUDBASE_SERVICE_URL=your-env-id.api.tcloudbasegateway.com

# 地域，默认 ap-shanghai
# TCB_REGION=ap-shanghai

# 覆盖模型白名单
# ALLOWED_MODELS=hy4,deepseek-v4.1-flash

# 服务端口，云托管会注入 PORT，本地默认 8080
# PORT=8080

# 设为 0 可关闭每次请求的日志
# RELAY_LOG=1
